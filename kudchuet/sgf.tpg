<% @TinyPG Namespace="sgf" Language="rust" OutputPath="./src/sgf" %>
<% @Scanner UseFancyRegex="False" %>
<% @ParseTree HeaderCode={
use std::collections::HashMap;
pub struct SGFTreeNode {
	pub attributes: HashMap<String, Vec<Vec<String>>>,
	pub children: Vec<SGFTreeNode>,
}
impl SGFTreeNode {
	fn new() -> Self {
		Self {
			attributes: HashMap::new(),
			children: Vec::new(),

		}
	}
}
fn unescape(s: &str) -> String {
	let mut out = String::new();
	let mut escaped = false;

	for c in s.chars() {
		if escaped {
			out.push(c);
			escaped = false;
		} else if c == '\\' {
			escaped = true;
		} else {
			out.push(c);
		}
	}
	out
}};
%>


[Skip]			WHITESPACE	-> @"\s+";
			EOF		-> @"$";


[Color(0, 128, 0)]	BROPEN		-> @"\[";
[Color(0, 128, 0)]	BRCLOSE	-> @"\]";

[Color(0, 0, 128)]	PAROPEN	-> @"\(";
[Color(0, 0, 128)]	PARCLOSE	-> @"\)";
[Color(128, 0, 0)]	SEMICOLON	-> @";";
[Color(128, 0, 0)]	COLON		-> @":";

[Color(255, 128, 128)] IDENT	-> @"[a-zA-Z][a-zA-Z0-9]*";

[Color(128, 128, 128)] CONTENT -> @"([^\\\]:]|\\(.|\n))*";
//[Color(128, 128, 128)] CONTENT -> @"[a-zA-Z0-9 _]*";


Start	 	-> Tree : SGFTreeNode {
	$Tree
};
Tree -> PAROPEN TreeNode+ PARCLOSE : SGFTreeNode {
	let mut root = SGFTreeNode::new();
	let mut i = 0;
	while ?TreeNode[i]
	{
		let c = $TreeNode[i];
		root.children.push(c);
		i+=1;
	}
	root
};
TreeNode -> LeafNode|Tree : SGFTreeNode {
	if ?LeafNode {
		$LeafNode
	} else {
		$Tree
	}
};

LeafNode -> SEMICOLON Attribute* : SGFTreeNode {
	let mut node = SGFTreeNode::new();
	let mut i = 0;
	while ?Attribute[i] {
		let att = $Attribute[i];
		node.attributes.insert(att.0, att.1);
		i += 1;
	}
	node
};

Attribute -> IDENT (BROPEN Tuple BRCLOSE)+ : (String, Vec<Vec<String>>)
{
	let mut content = Vec::new();
	let mut i = 0;
	while ?Tuple[i] {
		content.push($Tuple[i]);
		i += 1;
	}
	($IDENT, content)
};
Tuple -> CONTENT (COLON CONTENT)* : Vec<String> {
	let mut tuple = vec![];
	let mut i = 0;
	while ?CONTENT[i] {
		tuple.push(unescape($CONTENT[i].replace("\\\n", "").as_str()));
		i += 1;
	}
	tuple
};

